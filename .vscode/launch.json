{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Task Master",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "To-do application running at (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
